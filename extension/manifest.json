{
  "manifest_version": 3,
  "name": "Aegis Phishing Shield",
  "version": "1.0",
  "description": "Enterprise-grade real-time phishing and fraud detection for your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Current Page"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
